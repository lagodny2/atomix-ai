# === Atomix AI — Environment Variables ===
# Copy this to .env and fill in your real values.
# In production (Netlify), set these in Environment Variables settings.

# ---- API Keys (required) ----
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# ---- Optional Model Config ----
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_VISION_MODEL=
# GEMINI_VISION_MODEL=gemini-2.5-flash-lite

# ---- Rate Limits ----
# CHAT_RATE_LIMIT_PER_MINUTE=20
# APPEALS_RATE_LIMIT_PER_MINUTE=3

# ---- CORS ----
# ALLOWED_ORIGINS=https://yoursite.com,https://app.yoursite.com

# ---- Security Prompts (recommended for production) ----
# Store prompts as env vars instead of .txt files for maximum security.
# This prevents prompts from being visible in source code or Electron app files.
# PROMPT_BASIC=Your basic system prompt text here...
# PROMPT_BEFORE_JAILBREAK=Your pre-jailbreak warning prompt here...
# PROMPT_JAILBREAK=Your jailbreak mode prompt here...

# ---- Prompt File Path (fallback, not recommended for Electron) ----
# Only used if env var prompts above are not set.
# PROMPT_FILE_ROOT=D:\DIC\site-config
